PORT=5000
# Use 127.0.0.1, not "localhost": on Windows "localhost" can resolve to IPv6 (::1) and MongoDB listens on IPv4 only
MONGO_URI=mongodb://127.0.0.1:27017/tourist_safety
JWT_SECRET=change-this-to-any-long-random-string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Hardhat node started with "npm run chain"
CHAIN_RPC_URL=http://127.0.0.1:8545
